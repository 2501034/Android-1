<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 섭씨 -> 화씨 섹션 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="섭씨 온도를 입력하세요."
        android:textColor="#666666"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editCel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:hint="섭씨 온도를 입력하세요"
        android:inputType="numberDecimal|numberSigned"
        android:singleLine="true" />

    <Button
        android:id="@+id/btnCtoF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/purple_500"
        android:text="화씨온도 계산"
        android:textColor="@color/white" />

    <!-- 화씨 -> 섭씨 섹션 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="화씨 온도를 입력하세요."
        android:textColor="#666666"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/editFah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:hint="온도를 입력하세요"
        android:inputType="numberDecimal|numberSigned"
        android:singleLine="true" />

    <Button
        android:id="@+id/btnFtoC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/purple_500"
        android:text="섭씨온도 계산"
        android:textColor="@color/white" />

    <!-- 하단 결과 표시 -->
    <TextView
        android:id="@+id/textResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="결과"
        android:textColor="#333333"
        android:textSize="16sp" />

</LinearLayout>